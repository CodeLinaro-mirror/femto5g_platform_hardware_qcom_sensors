package com.qualcomm.qti.sensor

import com.qualcomm.qti.sensor.SensorInterfaceTypes.* from "SensorInterfaceTypes.fidl"

/**
    @description :

**/
interface SensorInterface {
    version { major 1 minor 0 }
    

    /**
        
        @description :
            send sensor service state information
                        
        @experimental: asil-level  : ASIL_QM
        
        @experimental: exclusion_time  : 100
    **/
    broadcast SensorCapabilities {
        out {

            /**
                @description : None 
                
            **/
            SensorServiceStateMaskT SensorCapabilitiesMask

        }
    }
    /**
        
        @description :
            SensorConfigUpdate is for notifying the client with updated sampling 
            rate and batch count with sensor identifier. 
             It contains : 
            The sensor identifier, the reported sampling rate 
            (nearest or equal to supported sampling rate (SensorInfoT->odr[]) 
            for requested sampling rate by SensorConfigReq api.) 
            and the reported batch 
            count (multiplication of minBatchCount and will be nearest to or 
            equal to requested batch count in SensorConfigReq).
                        
        @experimental: asil-level  : ASIL_QM
        
        @experimental: exclusion_time  : 100
    **/
    broadcast SensorConfigUpdate {
        out {

            /**
                @description : None 
                
            **/
            Int32 sensorId

            /**
                @description : None 
                
            **/
            Float samplingRate

            /**
                @description : None 
                
            **/
            Int32 batchCount

        }
    }
    /**
        
        @description :
            SensorImuData is for receiving sensor Inertial Measurement Unit data. 
            This callback is invoked for every sensor when batch count is 
            reached to the requested batch count by that sensor. It contains 
            the sensor events and the total number of events.
                        
        @experimental: asil-level  : ASIL_QM
        
        @experimental: exclusion_time  : 10
    **/
    broadcast SensorImuDataRead {
        out {

            /**
                @description : None 
                
                    
                @experimental: size: 50
                    
                
            **/
            SensorImuEventT [] SensorImuEvent

            /**
                @description : None 
                
            **/
            Int32 count

        }
    }
    /**
        
        @description :
            SensorHeadingData is for receiving sensor heading data. 
            This callback is invoked for every sensor when batch count is 
            reached to the requested batch count by that sensor. It contains 
            the sensor events and the total number of events.
                        
        @experimental: asil-level  : ASIL_QM
        
        @experimental: exclusion_time  : 10
    **/
    broadcast SensorHeadingDataRead {
        out {

            /**
                @description : None 
                
                    
                @experimental: size: 50
                    
                
            **/
            SensorHeadEventT [] sensorHeadEvent

            /**
                @description : None 
                
            **/
            Int32 count

        }
    }
    
    
    
        
    /**
        @description :
            Register new sensor client 
            Creates an instance of new SensorClient 
            on Success of new client creation SensorServiceStateT will be called 
            to notify the status of sensor service through 
            SensorServiceStateMaskT 
            @returns: SensorResponseT
                        
        @experimental: asil-level  : 
        @experimental: periodicity :
        @experimental: exclusion-time : 
    **/
    method RegisterSensorClientReq {
            
            
        out {

            /**
                @description : None 
                
            **/
            SensorReturnT SensorResponse

        }
            
    }
        
    /**
        @description :
            DeRegister sensor client 
            Delete instance of SensorClient 
            @returns: SensorResponseT
                        
        @experimental: asil-level  : 
        @experimental: periodicity :
        @experimental: exclusion-time : 
    **/
    method DeRegisterSensorClientReq {
            
            
        out {

            /**
                @description : None 
                
            **/
            SensorReturnT SensorResponse

        }
            
    }
        
    /**
        @description :
            get the sensor list 
            It will returns the list of sensors supported by hardware, 
            see “SensorInfoT” for details on how the sensors are defined. 
            The “count” represesnt number of sensors in the list, 
            basically it represensts array size of pointer to SensorInfoT, 
            to access each sensor 
            need to loop the SensorInfoT from 0 to count ex: if count is 2 then 
            for(int i=0; i< count; i++) 
            where “SensorInfoT[i]” represent each sensor 
            @param[out] SensorInfoT: contains sensor information of sensor 
            @param[out] count: total number of sensor supported 
            @returns: SensorResponseT
                        
        @experimental: asil-level  : 
        @experimental: periodicity :
        @experimental: exclusion-time : 
    **/
    method GetSensorListReq {
            
            
        out {

            /**
                @description : None 
                
                    
                @experimental: size: 10
                    
                
            **/
            SensorInfoT [] SensorList

            /**
                @description : None 
                
            **/
            Int32 count

        }
            
    }
        
    /**
        @description :
            Configure sensor 
            for interested sampling rate and batch count 
            Configure the sensor identified by sensor_id with given parameters 
            The sampling rate should be sampling rate supported by SensorInfoT 
            and should be less than or equal to maxSampling rate reported by 
            sensor list, its in HZ. The batching count should not exceed 
            maxBatchCount provided by SensorInfoT. 
            The SensorConfigUpdateT will be invoked to notify client about 
            sensor configured sampling rate and batch count 
            @param[in]  sensor_id: sensor identifier. 
            @param[in]  sampling_rate: sampling rate of sensors in HZ. 
            @param[in]  batch_count: batch count of sensor events 
            @returns:   SensorResponseT
                        
        @experimental: asil-level  : 
        @experimental: periodicity :
        @experimental: exclusion-time : 
    **/
    method SensorConfigReq {
            
        in {

            /**
                @description : None 
                
            **/
            Int32 sensorId

            /**
                @description : None 
                
            **/
            Float samplingRate

            /**
                @description : None 
                
            **/
            Int32 batchCount

        }
            
            
        out {

            /**
                @description : None 
                
            **/
            SensorReturnT SensorResponse

        }
            
    }
        
    /**
        @description :
            Activates/deactivates a sensor 
            Activates or deactivates the sensor, sensor’s sensor_id is defined by 
            the sensor_id field of SensorInfoT structure used to activate and 
            deactivate the respective sensor. 
            sensorState is set to SENSOR_STATE_ENABLE to activate the sensor or 
            set to SENSOR_STATE_DISABLE to deactivate the sensor. 
            Activate/Deactivate the sensor identified by sensor_id, 
            in order to get the sensor data, 
            enabling the sensor is not enough, the client must configure sensor 
            by calling SensorConfigReq API 
            @param[in] sensor_id: sensor identifier 
            @param[in] sensorState: SENSOR_STATE_ENABLE to activate and 
            SENSOR_STATE_DISABLE to deactivate the sensor. 
            @returns:  SensorResponseT
                        
        @experimental: asil-level  : 
        @experimental: periodicity :
        @experimental: exclusion-time : 
    **/
    method SensorControlReq {
            
        in {

            /**
                @description : None 
                
            **/
            Int32 sensorId

            /**
                @description : None 
                
            **/
            SensorStateT sensorState

        }
            
            
        out {

            /**
                @description : None 
                
            **/
            SensorReturnT SensorResponse

        }
            
    }
        
    
}
