package com.qualcomm.qti.sensor

interface SensorInterface {
    version { major 0 minor 1 }

    /** @brief Provides the capabilities of the sensor service. <br/>
        @param capsMask: SensorCapabilitiesMask. <br/>
    **/
    broadcast SensorCapabilities {
        out {
             SensorCapabilitiesMask capsMask
        }
    }

    /** @brief
        SensorConfigUpdate is for notifying the client with updated sampling
        rate and batch count with sensor identifier.

        @param[out] sensorId: sensor identifier.
        @param[out] samplingRate: The reported sampling rate will be nearest or equal to supported sampling rate
                   (SensorList->odr[]) for requested sampling rate by SensorConfig api.
        @param[out] batchCount: The reported batch count is multiplication of minBatchCount and
                   will be nearest to or equal to requested batch count in SensorConfig.
    **/
    broadcast  SensorConfigUpdate {
	out {
	     Int32 sensorId
	     Float samplingRate
	     Int32 batchCount
	}
    }

    /** @brief
        SensorDataRead is for receiveing sensor data.

        This callback is invoked for every sensor when batch count is
        reached to the requested batch count by that sensor.

        @param[out] SensorEvent: the sensor events.
        @param[out] count: the total number of events.
    **/
    broadcast  SensorDataRead {
	out {
	     SensorEvent [] events 
	     Int32 count
	}
    }

    /** @brief new sensor client <br/>

        Creates an instance of new SensorClient. <br/>
	on Success of new client creation SensorCapabilities will be called to notify the status
	of sensor service through SensorCapabilitiesMask.
        @returns: SensorResponse

    **/
    method RegisterSensorClient {
        out {
             SensorResponse response
	}
    }

    /** @brief delete sensor client instance <br/>

        Delete instance of SensorClient. <br/>
        @returns: SensorResponse

    **/
    method DeRegisterSensorClient {
        out {
             SensorResponse response
        }
    }

    /** @brief get the sensor list  <br/>

        It will returns the list of sensors supported by hardware, see “SensorList” for details on
        how the sensors are defined. The “count” represesnt number of sensors in the list,
        basically it represensts array size of pointer to SensorList, to access each
        sensor, need to loop the SensorList from 0 to “count” times.
        ex: if count is 2 then
        for(int i=0; i< count; i++)  where “SensorList[i]” represent represent each sensor

        @param[out] SensorList: contains sensor specific information of available sensor.
        @param[out] count: total number of sensor supported.
        @returns: SensorResponse

    **/
    method GetSensorList {
	out{
	    SensorList [] sensor
            Int32 count
	}
    }

    /** @brief Configure sensor for interested sampling rate and batch count <br/>

        Configure the sensor identified by sensorId with given parameters.
        The sampling rate should be sampling rate supported by SensorList and should be
        less than or equal to maxSampling rate reported by sensor list, its in HZ.
        The batching count should not exceed maxBatchCount provided by SensorList.
        The SensorConfigUpdate will be invoked to notify client about sensor configured sampling rate and
        batch count.

        @param[in]  sensorId: sensor identifier.
        @param[in]  samplingRate: sampling rate of sensors in HZ. <br/>
        @param[in]  batchCount: batch count of sensor events. <br/>
        @returns:   SensorResponse

    **/
    method SensorConfig {
        in {
	    Int32 sensorId
	    Float samplingRate
	    Int32 batchCount
        }
        out {
            SensorResponse response
        }
    }

   /** @brief Activates or deactivates a sensor <b/r>

        Activates or deactivates the sensor, sensor’s sensorId is defined by the sensorId field
        of SensorList structure used to activate and deactivate the respective sensor.
        sensorState is set to SENSOR_ENABLE to activate the sensor or set to SENSOR_DISABLE to deactivate the sensor.
        Activate/Deactivate the sensor identified by sensorId, in order to get the sensor data,
        enabling the sensor is not enough, the client must configure sensor by calling sensor_config API

        @param[in] sensorId: sensor identifier. <br/>
        @param[in] sensorState: SENSOR_ENABLE to activate and SENSOR_DISABLE to deactivate the sensor. <br/>
        @returns:  SensorResponse

    **/
    method SensorControl {
        in {
           Int32 sensorId
           SensorState sensorState
        }
        out {
            SensorResponse response
        }
    }

    /** @brief SENSOR_TYPES <br/>
                sensor Types: Possible Sensor Types represented “SensorList->type”
    **/
    enumeration Sensortype {
        /** An calibreated accelerometer sensor reports the acceleration of the device along the three sensor axes.
            The measured acceleration includes both the physical acceleration (change of velocity) and the gravity. 
	    The measurement is reported in the x, y, and z fields of SensorEvent.SensorUncalibratedEvent
	    where bias value remains non-zero.
 
	    All values are in SI units (m/s^2) and measure the acceleration of the device minus the force of gravity 
	    along the three sensor axes.

            reporting-mode: continuous
	**/
	SENSOR_TYPE_ACCELEROMETER = 1

        /** An calibrated gyroscope sensor reports the rate of rotation around the sensor axes with applying bias compensation
             to them, along with a bias estimate.

             All values are in radians/second and are reported in the fields of SensorEvent.SensorUncalibratedEvent
             where bias values remains zero.

             reporting-mode: continuous
        **/
        SENSOR_TYPE_GYROSCOPE 	= 4

        /** An uncalibrated gyroscope reports the rate of rotation around the sensor axes without applying bias compensation
	     to them, along with a bias estimate. 

	     All values are in radians/second and are reported in the fields of SensorEvent.SensorUncalibratedEvent
	     where bias values remains zero. 	

	     reporting-mode: continuous
        **/
	SENSOR_TYPE_GYROSCOPE_UNCALIBRATED = 16

        /** An uncalibreated accelerometer sensor reports the acceleration of the device along the three sensor axes.
             The measured acceleration includes both the physical acceleration (change of velocity) and the gravity.
             The measurement is reported in the x, y, and z fields of SensorEvent.SensorUncalibratedEvent
	     while bias values zero

             All values are in SI units (m/s^2) and measure the acceleration of the device minus the force of gravity
             along the three sensor axes.

             reporting-mode: continuous
        **/
	SENSOR_TYPE_ACCELEROMETER_UNCALIBRATED = 35

        /** heading sensor measures the direction in which the device is pointing relative to true north in degrees. 
             The heading sensor includes two SensorEvent values represent by SensorEvent.SensorHeadingEvent
	     One for the measured device heading and one for the accuracy of the provided heading value.

             Heading values reported by this sensor must be between 0.0 (inclusive) and 360.0 (exclusive), 
             with 0 indicating north, 90 east, 180 south, and 270 west.
        **/
	SENSOR_TYPE_HEADING = 5 
    }

    enumeration SensorResponse {
        /** On Success **/
        SENSOR_RESPONSE_SUCCESS = 0
        /** Client is not registered to SHD **/
        SENSOR_ERROR_CLIENT_REGISTER_FAILED = -1
        /** Client is not generated while registering the client **/
        SENSOR_ERROR_INVALID_CLIENT = -2
        /** Invalid input parameteres from respective AP **/
        SENSOR_ERROR_INVALID_INPUT_PARAMETER = -3
        /** Physical Sensor Enable/Disable failed **/
        SENSOR_ERROR_CONTROL_FAILED = -4
        /** Physical Sensor Config failed **/
        SENSOR_ERROR_CONFIG_FAILED = -5
        /** No sensors supported in h/w **/
        SENSOR_ERROR_NO_SENSORS_FOUND = -6
        /**No snesor is activated and configured**/
        SENSOR_ERROR_TRACKING_FAILED = -7
        /** Unknown error **/
        SENSOR_ERROR_UNKNOWN = -8
    }

    enumeration SensorState {
        /**Disable the sensor**/
        SENSOR_DISABLE = 0
        /**Enable the sensor**/
        SENSOR_ENABLE = 1
    }

    enumeration SensorCapabilitiesMask {
        /*Senshor HAL Deamon is ready to communicate*/
        SHD_READY        = 0x00000001
    }

    struct SensorList {
        /** Version of the hardware part + driver. The value of this field
            must increase when the driver is updated in a way that changes the
            output of this sensor. This is important for fused sensors when the
            fusion algorithm is updated.
        **/
        Int32 sensorVersion
        /** Name of this sensor.
            All sensors of the same "type" must have a different "name".
        **/
        String name
        /** Vendor of the hardware part	**/
	String vendor
        /** Sensor ID that identifies this sensors. This is used to reference
            this sensor throughout the Sensor API.
        **/
	Int32 sensorId
        /** This sensor's type **/
	Int32 type
        /** Max sampling rate supported by the sensor in HZ,
            client can’t request the samples more than this
        **/
	Float maxSamplingRate
        /** Min batch count supported by the sensor,
            client can’t request the samples less than this
        **/
	Int32 minBatchCount
        /** Max batch count supported by the sensor,
            client can’t request the samples more than this
        **/
	Int32 maxBatchCount
        /** ODR - output data rate, List of sampling rate supported by the sensor in HZ
	**/
	Float []odr
	/** Range of sensor **/
	Int32 range
	/** Smallest difference between two values reported by this sensor **/
	Float resolution
        /** Maximum range of this sensor's value in SI units **/
	Float maxRange
    }

    /**
        Heading event data
    **/
    struct SensorHeadingEvent {
        Float heading
	Float accuracy
    }

    /**
        uncalibrated and calibrated accelerometer, gyroscope event data
    **/
    struct SensorUncalibratedEvent {
	Float x_uncalib
	Float y_uncalib
	Float z_uncalib
	Float x_bias
	Float y_bias
	Float z_bias
    }

    union SensorData {
	/* uncalibrated accel and gyro data */
	SensorUncalibratedEvent imu_event
        /* heading event data */
	SensorHeadingEvent heading_event
    }

    /** various types of sensor data **/
    struct SensorEvent {
	/* sensor identifier */
	Int32 sensorId
        /* sensor type */
	Int32 type
        /* time is in nanosecond */
	Int64 timestamp
	/* gptp time is in nanosecond */
	Int64 gptptimestamp
	/* sensor data */
	SensorData data
    }
}
