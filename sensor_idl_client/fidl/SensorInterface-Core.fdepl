import "platform:/plugin/org.genivi.commonapi.core/deployment/CommonAPI_deployment_spec.fdepl"
import "SensorInterface.fidl"

define org.genivi.commonapi.core.deployment for interface com.qualcomm.qti.sensor.SensorInterface {
    DefaultEnumBackingType = UInt32

    enumeration Sensortype {
        EnumBackingType = UInt32
    }

    enumeration SensorResponse {
        EnumBackingType = Int32
    }

    enumeration SensorState {
        EnumBackingType = UInt32
    }

    enumeration SensorCapabilitiesMask {
        EnumBackingType = UInt32
    }
}
