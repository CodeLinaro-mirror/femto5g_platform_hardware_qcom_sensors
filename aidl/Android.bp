package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_interfaces_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //default_applicable_licenses: ["hardware_interfaces_license"],
}

prebuilt_etc {
    name: "vsomeip-sensor_client.json",
    vendor: true,
    src: "./SensorInterfaceClient/vsomeip-sensor_client.json",
}
prebuilt_etc {
    name: "vsomeip-sensor_test_client.json",
    vendor: true,
    src: "./SensorInterfaceClient/vsomeip-sensor_test_client.json",
}
gen_core_stub_srcs = [
    "src-gen/core/v0/com/qualcomm/qti/sensor/*Stub*.cpp"
]
gen_core_proxy_srcs = [
    "src-gen/core/v0/com/qualcomm/qti/sensor/*Proxy.cpp"
]
gen_someip_srcs = [
    "src-gen/someip/v0/com/qualcomm/qti/sensor/*.cpp"
]
cc_library_headers {
    name: "libSensorInterface-proxy_headers",
    export_include_dirs: [
       "src-gen/someip",
       "src-gen/core",
    ],
    vendor: true,
}

cc_library_shared {
    name: "libSensorInterface-someip",
    vendor: true,
    srcs: gen_someip_srcs,
    defaults: [
        "sensorSomeip_defaults"
    ],
    local_include_dirs: [
       "src-gen/someip",
       "src-gen/core",
    ]
}

cc_library_shared {
    name: "libSensorInterface-proxy",
    vendor: true,
    srcs: gen_core_proxy_srcs,
    defaults: [
        "sensorSomeip_defaults"
    ],
}

cc_defaults {
    name: "sensorSomeip_defaults",
    vendor: true,
    cppflags: [
        "-fexceptions",
        "-fpermissive",
        "-Wno-attributes",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-overloaded-virtual"
    ],
    shared_libs: [
        "libvsomeip",
        "libvsomeip_cfg",
        "libvsomeip_e2e",
        "libvsomeip_sd",
        "libCommonAPI-SomeIP",
        "libCommonAPI",
        "liblog",
        "libdl",
    ],
   rtti: true,
}

cc_library_shared {
    name: "libSensor-core-api",
    vendor: true,
    defaults: ["sensorSomeip_defaults"],
    srcs: [
        "core/lib/SensorCore.cpp",
    ],
    local_include_dirs: [
       "core/lib/",
    ],
    shared_libs: [
       "libSensorInterface-someip",
       "libSensorInterface-proxy",
       "libutils",
       "libcutils",
    ],
    header_libs: [
       "libgptp_headers",
       "libSensorInterface-proxy_headers",
    ],
}

cc_library_headers {
    name: "libSensor-core-api_headers",
    export_include_dirs: [
       "core/lib/",
    ],
    vendor: true,
}

cc_binary {
    name: "SensorInterfaceClient",
    defaults: ["sensorSomeip_defaults"],
    srcs: [
        "SensorInterfaceClient/src/SensorInterfaceClient.cpp",
    ],
    local_include_dirs: [
       "SensorInterfaceClient/src",
    ],
    shared_libs: [
       "libSensorInterface-someip",
       "libSensorInterface-proxy",
    ],
    header_libs: [
       "libgptp_headers",
       "libSensorInterface-proxy_headers",
    ],
}

filegroup {
    name: "android.hardware.sensors@aidl-service-qc.rc",
    srcs: ["android.hardware.sensors@aidl-service-qc.rc"],
}

filegroup {
    name: "android.hardware.sensors@aidl-service-qc.xml",
    srcs: ["android.hardware.sensors@aidl-service-qc.xml"],
}

cc_library_static {
    name: "libsensorsimpl",
    vendor: true,
    shared_libs: [
        "libbase",
        "libfmq",
        "libpower",
        "libbinder_ndk",
        "android.hardware.sensors-V2-ndk",
    ],
    export_include_dirs: ["include"],
    srcs: [
        "Sensors.cpp",
        "Sensor.cpp",
    ],
    header_libs: [
       "libSensor-core-api_headers",
    ],
    visibility: [
        ":__subpackages__",
        "//hardware/interfaces/tests/extension/sensors:__subpackages__",
    ],
}

cc_binary {
    name: "android.hardware.sensors@aidl-service-qc",
    relative_install_path: "hw",
    init_rc: ["android.hardware.sensors@aidl-service-qc.rc"],
    vintf_fragments: ["android.hardware.sensors@aidl-service-qc.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libfmq",
        "libpower",
        "libcutils",
        "liblog",
        "libutils",
        "android.hardware.sensors-V2-ndk",
	"libSensor-core-api",
    ],
    header_libs: [
       "libSensor-core-api_headers",	
    ],
    static_libs: [
        "libsensorsimpl",
    ],
    srcs: ["main.cpp"],
}
