import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "SensorInterfaceTypes.fidl"
import "SensorInterface.fidl"

define org.genivi.commonapi.someip.deployment for interface com.qualcomm.qti.sensor.SensorInterface {
    SomeIpServiceID = 60929    /** 0xEE01*/

    method RegisterSensorClientReq {
        SomeIpMethodID = 32001      /** 0x7D01 */
        SomeIpReliable = true
    }

    method DeRegisterSensorClientReq {
        SomeIpMethodID = 32002      /** 0x7D02 */
        SomeIpReliable = true
    }

    method GetSensorListReq {
        SomeIpMethodID = 32003      /** 0x7D03 */
        SomeIpReliable = true
    }

    method SensorConfigReq {
        SomeIpMethodID = 32004      /** 0x7D04 */
        SomeIpReliable = true
    }

    method SensorControlReq {
        SomeIpMethodID = 32005      /** 0x7D05 */
        SomeIpReliable = true
    }

    broadcast SensorCapabilities {
        SomeIpEventID = 33001      /** 0x80E9 */
        SomeIpEventGroups = { 33000 }
        out {
        }
    }

    broadcast SensorConfigUpdate {
        SomeIpEventID = 33002      /** 0x80EA */
        SomeIpEventGroups = { 33000 }
        out {
        }
    }

    broadcast SensorImuDataRead {
        SomeIpEventID = 33003      /** 0x80EB */
        SomeIpEventGroups = { 33000 }
        out {
        }
    }

    broadcast SensorHeadingDataRead {
        SomeIpEventID = 33004      /** 0x80EC */
        SomeIpEventGroups = { 33000 }
        out {
        }
    }
}

define org.genivi.commonapi.someip.deployment for typeCollection com.qualcomm.qti.sensor.SensorInterfaceTypes {

    enumeration SensorTypeT {
        SomeIpEnumWidth = 4
    }

    enumeration SensorReturnT {
        SomeIpEnumWidth = 4
    }
  
    enumeration SensorStateT {
        SomeIpEnumWidth = 4
    }

    enumeration SensorServiceStateMaskT {
        SomeIpEnumWidth = 4
    }

    struct SensorInfoT {
        sensorVersion    {}
        name             {}
        vendor           {}
        sensorId         {}
        type             {}
        maxSamplingRate  {}
        minBatchCount    {}
        maxBatchCount    {}
        odr              {}
        resolution       {}
        maxRange         {}
    }

    struct SensorHeadingEventT {
        heading          {}
        accuracy         {}
    }

    struct SensorHeadEventT {
        sensorId      {}
        type          {}
        timestamp     {}
        gptpTimestamp {}
        data          {}
    }

    struct SensorUncalibratedEventT {
        xUncalib        {}
        yUncalib        {}
        zUncalib        {}
        xBias           {}
        yBias           {}
        zBias           {}
    }

    struct SensorImuEventT {
        sensorId         {}
        type             {}
        timestamp        {}
        gptpTimestamp    {}
        data             {}
    }
}

define org.genivi.commonapi.someip.deployment for provider as Service {
    instance com.qualcomm.qti.sensor.SensorInterface {
        InstanceId = "com.qualcomm.qti.sensor.SensorInterface"

        SomeIpInstanceID = 1        /**Instance 0x01*/

        SomeIpUnicastAddress = "192.168.1.1"
        SomeIpReliableUnicastPort = 30499
        SomeIpUnreliableUnicastPort = 30499
    }
}

